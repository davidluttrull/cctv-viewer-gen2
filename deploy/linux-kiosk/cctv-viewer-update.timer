[Unit]
Description=Daily CCTV Viewer update check

[Timer]
# Overnight, so the seconds-long restart an update needs does not land in the
# middle of a school day. The jitter keeps every site from hitting GitHub at
# the same instant once this is deployed more widely.
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=30m
# Catch up after the machine has been off; a kiosk that was unplugged for a
# week should still update on the next boot rather than waiting for 04:00.
Persistent=true

[Install]
WantedBy=timers.target
